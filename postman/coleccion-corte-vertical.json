  "item": [
    {
      "name": "01 Token de la billetera (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/api/v1/auth/token",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "token"
          ]
        },
        "description": "Cambia clientId + secreto por un token JWT. Prepara los códigos de operación de esta corrida.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"billetera-externa\",\n  \"secreto\": \"billetera-2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"ref\", \"OP-\" + Date.now());",
              "pm.collectionVariables.set(\"ref2\", \"OP-\" + (Date.now() + 1));",
              "const d = new Date(); pm.collectionVariables.set(\"hoy\", d.getFullYear() + \"-\" + String(d.getMonth() + 1).padStart(2, \"0\") + \"-\" + String(d.getDate()).padStart(2, \"0\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 y entrega token\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"token_billetera\", pm.response.json().token);",
              "pm.test(\"Tipo Bearer\", function () { pm.expect(pm.response.json().tipo).to.eql(\"Bearer\"); });"
            ]
          }
        }
      ]
    },
