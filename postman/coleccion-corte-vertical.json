    {
      "name": "18 HU-03 — bitácora de AH-1001 hoy (200, menos de 5 s)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_auditor}}"
          }
        ],
        "url": {
          "raw": "{{base}}/api/v1/auditoria?cuenta=AH-1001&desde={{hoy}}&hasta={{hoy}}",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "auditoria"
          ],
          "query": [
            {
              "key": "cuenta",
              "value": "AH-1001"
            },
            {
              "key": "desde",
              "value": "{{hoy}}"
            },
            {
              "key": "hasta",
              "value": "{{hoy}}"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Todo quedó registrado: creada, rechazos, corrección y anulación\", function () { const filas = pm.response.json(); const ref = pm.collectionVariables.get(\"ref\"); const ref2 = pm.collectionVariables.get(\"ref2\"); const ops = filas.filter(f => f.referenciaExterna === ref).map(f => f.operacion + \":\" + f.resultado); pm.expect(ops).to.include(\"TRANSFERENCIA:EXITOSA\"); pm.expect(ops).to.include(\"TRANSFERENCIA:RECHAZADA\"); pm.expect(ops).to.include(\"ANULACION:EXITOSA\"); pm.expect(filas.filter(f => f.referenciaExterna === ref2).length).to.be.at.least(2); });",
              "pm.test(\"Cada fila trae su huella\", function () { pm.response.json().forEach(f => pm.expect(f.hashActual).to.have.lengthOf(64)); });",
              "pm.test(\"AC-01: la consulta del auditor responde en menos de 5 s\", function () { pm.expect(pm.response.responseTime).to.be.below(5000); });"
            ]
          }
        }
      ]
    },
