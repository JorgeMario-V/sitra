@startuml
title HU-01 "Registrar transferencia" — Diagrama de Secuencia UML (N-Capas)
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam maxMessageSize 170
skinparam ParticipantPadding 4
skinparam BoxPadding 4
autonumber

actor "Billetera\nexterna" as BD
participant "FiltroJwt\n«seguridad»" as SEG
participant "Transferencia\nController\n«presentación»" as CTRL
participant "Transferencia\nService\n«negocio»" as SRV
participant "Transferencia\nRepository\n«datos»" as REP
participant "Nucleo\nConector\n«conector»" as CON
participant "Auditoria\nService\n«negocio»" as AUD
database "PostgreSQL" as DB
participant "Núcleo\nlegado" as NL

BD -> SEG : POST /api/v1/transferencias + JWT

alt token ausente o inválido
  SEG --> BD : 401 Unauthorized
else token válido
  SEG -> CTRL : petición autenticada
  CTRL -> SRV : registrar(datos)
  SRV -> REP : existePorReferencia()
  REP -> DB : SELECT

  alt referencia repetida
    SRV --> CTRL : ReferenciaDuplicada
    CTRL --> BD : 409 Conflict
  else referencia nueva
    SRV -> REP : guardar(PENDIENTE)
    REP -> DB : INSERT
    SRV -> CON : ejecutarTransferencia()
    CON -> NL : interfaz existente

    alt núcleo no responde en 5 s
      CON --> SRV : NucleoNoDisponible
      SRV -> REP : estado = FALLIDA
      REP -> DB : UPDATE
      SRV -> AUD : registrar(FALLIDA)
      AUD -> DB : INSERT bitácora
      CTRL <-- SRV : ServicioNoDisponible
      CTRL --> BD : 503 Service Unavailable
    else camino feliz
      NL --> CON : comprobante
      CON --> SRV : comprobante
      SRV -> REP : estado = CONFIRMADA
      REP -> DB : UPDATE
      SRV -> AUD : registrar(EXITOSA)
      AUD -> DB : INSERT bitácora\n(hashAnterior, hashActual)
      SRV --> CTRL : confirmada
      CTRL --> BD : 201 Created + JSON
    end
  end
end
@enduml
