@startuml
title Vista de Contenedores / Capas (C4 Nivel 2) — SITRA
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial

actor "Billetera digital\nexterna" as BD
actor "Auditor /\nOficial de cumplimiento" as AU

package "API SITRA\n[Java 21 + Spring Boot 3.3 — JAR ejecutable, puerto 8080]" as API {
  component "Capa de seguridad\n[FiltroJwt + JwtServicio (HMAC-SHA256 del JDK) + BCrypt]\nsin token válido: 401" as SEG
  component "Capa de presentación\n[Spring Web — controladores REST]\nAuthController · TransferenciaController\nSaldoController · AuditoriaController" as CTRL
  component "Capa de negocio\n[Java — servicios]\nTransferenciaService · CuentaService\nAuditoriaService · IdentificacionService" as SRV
  component "Capa de datos\n[Spring Data JPA + Hibernate]\nrepositorios + entidades" as REP
  component "Conector del núcleo\n[interfaz NucleoConector]\nNucleoSimuladoConector | NucleoLegadoConector" as CON
}

database "Base de datos SITRA\n[MariaDB 10.4 del XAMPP existente]\ntablas + triggers de la bitácora\n(huella SHA-256 encadenada)" as DB

component "Núcleo transaccional legado\n«sistema existente, NO se modifica»" as NL

BD --> SEG : HTTP :8080 (HTTPS en producción)\nJSON + Authorization: Bearer
AU --> SEG : HTTP :8080 (HTTPS en producción)\nJSON + Authorization: Bearer
SEG --> CTRL : petición autenticada
CTRL --> SRV : llamada en proceso
SRV --> REP : llamada en proceso
SRV --> CON : llamada en proceso
REP --> DB : JDBC · TCP :3306\n(solo red interna)
CON --> NL : interfaz existente del núcleo\n(protocolo por confirmar)
CON ..> DB : modo simulado:\ntabla nucleo_simulado_cuenta
@enduml
